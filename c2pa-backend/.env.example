# Copy to .env and edit as needed. The service reads from environment first,
# then from a .env file if present, then falls back to the defaults below.

# Which trust profile to use. One of: c2pa-prod | c2pa-prod+itl | dev
C2PA_TRUST_PROFILE=dev

# Where the trust-list PEM files live (relative to project root or absolute).
C2PA_TRUST_DIR=./trust

# HTTP bind. The extension expects 8001 by default to coexist with GeoCam on 8000.
C2PA_HOST=0.0.0.0
C2PA_PORT=8001

# Set to "true" only if you're OK with leaking the user's reading habits to CAs.
# Stapled OCSP attached to the manifest is consumed regardless of this flag.
C2PA_OCSP_LIVE=false

# Hard cap on how deep ingredient recursion may go. Guidance §7.2 warns about
# adversarial infinite-recursion DoS; c2pa-rs guards this internally too.
C2PA_MAX_INGREDIENT_DEPTH=10

# Maximum upload size in bytes (10 MiB by default). Beyond this we 413.
C2PA_MAX_UPLOAD_BYTES=10485760

# CORS origins (comma-separated). The browser extension calls from a background
# worker so CORS is irrelevant for it — this is for curl / dev tools / sandbox UI.
C2PA_CORS_ORIGINS=*
